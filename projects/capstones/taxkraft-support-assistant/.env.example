# Copy to .env — NEVER commit real keys.
#
# The chatbot works fully OFFLINE out of the box:
#   retrieval + guardrails + extractive answers + evaluation all run on CPU with no keys.
# Add one key below to enable fluent LLM-generated answers (OpenAI-compatible).
# GROQ offers a free tier: https://console.groq.com

# LLM provider: "groq" or "openai"
TAXKRAFT_LLM_PROVIDER=groq

# Groq (free tier)
GROQ_API_KEY=

# OpenAI (fallback provider)
OPENAI_API_KEY=

# Model IDs (defaults are fine)
TAXKRAFT_LLM_MODEL=llama-3.1-8b-instant
# TAXKRAFT_LLM_MODEL=gpt-4o-mini

# Tuning knobs (optional)
# TAXKRAFT_TOP_K=5
# TAXKRAFT_SCOPE_THRESHOLD=0.42
# TAXKRAFT_RETRIEVAL_THRESHOLD=0.35
# TAXKRAFT_FAITHFULNESS_THRESHOLD=0.30